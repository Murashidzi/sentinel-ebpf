[0.070733, "o", "\r\n\u001b[1;36m# sentinel-eBPF: eBPF tracepoints watching container system calls\u001b[0m\r\n"]
[1.572972, "o", "\u001b[1;32m$\u001b[0m docker run -d --privileged --pid=host --name demo python:3.12-slim sleep infinity\r\n"]
[2.78615, "o", "\u001b[1;32m$\u001b[0m sudo ./daemon/sentinel    # attach six tracepoints, print alerts\r\n"]
[7.791237, "o", "\r\n\u001b[1;36m# 1. Escape pattern: open the host PID namespace handle\u001b[0m\r\n"]
[9.293998, "o", "\u001b[1;32m$\u001b[0m docker exec demo sh -c 'cat /proc/1/ns/pid'    # repeated for 4 s\r\n"]
[13.381239, "o", "[ALERT] CRITICAL | CONTAINER_ESCAPE | 103d2bb8b965\r\n    evidence={\"filename\":\"/proc/1/ns/pid\",\"parent_comm\":\"sh\",\"pid\":10287,\"ppid\":10268}\r\n"]
[15.396411, "o", "[ALERT] CRITICAL | CONTAINER_ESCAPE | 103d2bb8b965\r\n    evidence={\"filename\":\"/proc/1/ns/pid\",\"parent_comm\":\"sh\",\"pid\":10296,\"ppid\":10268}\r\n"]
[15.900583, "o", "[ALERT] CRITICAL | CONTAINER_ESCAPE | 103d2bb8b965\r\n    evidence={\"filename\":\"/proc/1/ns/pid\",\"parent_comm\":\"sh\",\"pid\":10298,\"ppid\":10268}\r\n"]
[16.304967, "o", "\r\n\u001b[1;36m# Each alert names the parent process: the shell that ran cat\u001b[0m\r\n"]
[19.427651, "o", "[ALERT] CRITICAL | CONTAINER_ESCAPE | 103d2bb8b965\r\n    evidence={\"filename\":\"/proc/1/ns/pid\",\"parent_comm\":\"sh\",\"pid\":10316,\"ppid\":10268}\r\n"]
[19.810085, "o", "\r\n\u001b[1;36m# 2. Port scan: 100 connection attempts from the container\u001b[0m\r\n"]
[21.312496, "o", "\u001b[1;32m$\u001b[0m docker exec demo python3 -c '<connect to ports 1 to 100>'\r\n"]
[23.960676, "o", "[ALERT] CRITICAL | CONTAINER_ESCAPE | 103d2bb8b965\r\n    evidence={\"filename\":\"/proc/1/ns/pid\",\"parent_comm\":\"sh\",\"pid\":10368,\"ppid\":10268}\r\n"]
[24.918545, "o", "[ALERT] HIGH | PORT_SCAN | 103d2bb8b965\r\n    evidence={\"connect_count\":50,\"parent_comm\":\"containerd-shim\",\"ppid\":10153}\r\n"]
[26.983471, "o", "[ALERT] CRITICAL | CONTAINER_ESCAPE | 103d2bb8b965\r\n    evidence={\"filename\":\"/proc/1/ns/pid\",\"parent_comm\":\"sh\",\"pid\":10380,\"ppid\":10268}\r\n"]
[27.444245, "o", "[ALERT] HIGH | PORT_SCAN | 103d2bb8b965\r\n    evidence={\"connect_count\":50,\"parent_comm\":\"containerd-shim\",\"ppid\":10153}\r\n"]
