[27.992695, "o", "[ALERT] CRITICAL | CONTAINER_ESCAPE | 103d2bb8b965\r\n    evidence={\"filename\":\"/proc/1/ns/pid\",\"parent_comm\":\"sh\",\"pid\":10385,\"ppid\":10268}\r\n"]
