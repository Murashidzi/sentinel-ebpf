[0.072575, "o", "\r\n\u001b[1;36m# sentinel-eBPF: eBPF tracepoints watching container system calls\u001b[0m\r\n"]
[1.574691, "o", "\u001b[1;32m$\u001b[0m docker run -d --privileged --pid=host --name demo python:3.12-slim sleep infinity\r\n"]
[2.793531, "o", "\u001b[1;32m$\u001b[0m sudo ./daemon/sentinel    # attach six tracepoints, print alerts\r\n"]
[7.798656, "o", "\r\n\u001b[1;36m# 1. Escape pattern: open the host PID namespace handle\u001b[0m\r\n"]
[9.301038, "o", "\u001b[1;32m$\u001b[0m docker exec demo sh -c 'cat /proc/1/ns/pid'    # repeated for 4 s\r\n"]
[11.369942, "o", "[ALERT] CRITICAL | CONTAINER_ESCAPE | 90cbc6734764\r\n    evidence={\"filename\":\"/proc/1/ns/pid\",\"parent_comm\":\"sh\",\"pid\":10728,\"ppid\":10718}\r\n"]
[13.888141, "o", "[ALERT] CRITICAL | CONTAINER_ESCAPE | 90cbc6734764\r\n    evidence={\"filename\":\"/proc/1/ns/pid\",\"parent_comm\":\"sh\",\"pid\":10738,\"ppid\":10718}\r\n"]
[16.398969, "o", "\r\n\u001b[1;36m# Each alert names the parent process: the shell that ran cat\u001b[0m\r\n"]
[19.904185, "o", "\r\n\u001b[1;36m# 2. Port scan: 100 connection attempts from the container\u001b[0m\r\n"]
[21.406665, "o", "\u001b[1;32m$\u001b[0m docker exec demo python3 -c '<connect to ports 1 to 100>'\r\n"]
[24.999386, "o", "[ALERT] HIGH | PORT_SCAN | 90cbc6734764\r\n    evidence={\"connect_count\":50,\"parent_comm\":\"containerd-shim\",\"ppid\":10618}\r\n"]
[27.523744, "o", "[ALERT] HIGH | PORT_SCAN | 90cbc6734764\r\n    evidence={\"connect_count\":50,\"parent_comm\":\"containerd-shim\",\"ppid\":10618}\r\n"]
[30.58987, "o", "\r\n\u001b[1;36m# Detected live, with process lineage as evidence.\u001b[0m\r\n"]
