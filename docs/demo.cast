[20.748412, "o", "[sudo] password for murashidzi: "]
[31.881616, "o", "\r\n"]
[31.961299, "o", "\r\n\u001b[1;36m# sentinel-eBPF: eBPF tracepoints watching container system calls\u001b[0m\r\n"]
[33.463888, "o", "\u001b[1;32m$\u001b[0m docker run -d --privileged --pid=host --name demo python:3.12-slim sleep infinity\r\n"]
[34.67798, "o", "\u001b[1;32m$\u001b[0m sudo ./daemon/sentinel    # attach six tracepoints, print alerts\r\n"]
[39.683671, "o", "\r\n\u001b[1;36m# 1. Escape pattern: open the host PID namespace handle\u001b[0m\r\n"]
[41.186125, "o", "\u001b[1;32m$\u001b[0m docker exec demo sh -c 'cat /proc/1/ns/pid'    # repeated for 4 s\r\n"]
[48.197458, "o", "\r\n\u001b[1;36m# Each alert names the parent process: the shell that ran cat\u001b[0m\r\n"]
[51.701965, "o", "\r\n\u001b[1;36m# 2. Port scan: 100 connection attempts from the container\u001b[0m\r\n"]
[53.204403, "o", "\u001b[1;32m$\u001b[0m docker exec demo python3 -c '<connect to ports 1 to 100>'\r\n"]
[62.429562, "o", "\r\n\u001b[1;36m# Detected live, with process lineage as evidence.\u001b[0m\r\n"]
[64.255213, "o", "[ALERT] CRITICAL | CONTAINER_ESCAPE | a574dde86eec\r\n    evidence={\"filename\":\"/proc/1/ns/pid\",\"parent_comm\":\"sh\",\"pid\":9402,\"ppid\":9394}\r\n[ALERT] CRITICAL | CONTAINER_ESCAPE | a574dde86eec\r\n    evidence={\"filename\":\"/proc/1/ns/pid\",\"parent_comm\":\"sh\",\"pid\":9404,\"ppid\":9394}\r\n[ALERT] CRITICAL | CONTAINER_ESCAPE | a574dde86eec\r\n    evidence={\"filename\":\"/proc/1/ns/pid\",\"parent_comm\":\"sh\",\"pid\":9412,\"ppid\":9394}\r\n[ALERT] CRITICAL | CONTAINER_ESCAPE | a574dde86eec\r\n    evidence={\"filename\":\"/proc/1/ns/pid\",\"parent_comm\":\"sh\",\"pid\":9452,\"ppid\":9394}\r\n[ALERT] CRITICAL | CONTAINER_ESCAPE | a574dde86eec\r\n    evidence={\"filename\":\"/proc/1/ns/pid\",\"parent_comm\":\"sh\",\"pid\":9455,\"ppid\":9394}\r\n[ALERT] CRITICAL | CONTAINER_ESCAPE | a574dde86eec\r\n    evidence={\"filename\":\"/proc/1/ns/pid\",\"parent_comm\":\"sh\",\"pid\":9462,\"ppid\":9394}\r\n[ALERT] CRITICAL | CONTAINER_ESCAPE | a574dde86eec\r\n    evidence={\"filename\":\"/proc/1/ns/pid\",\"parent_comm\":\"sh\",\"pid\":9500,\"ppid\":9394}\r\n[ALERT] HIGH | PORT_SCAN | a574dde86eec\r\n    evidence={\"connect_count\":50,\"parent_comm\":\"containerd-shim\",\"ppid\":9290}\r\n[ALERT] HIGH | PORT_SCAN | a574dde86eec\r\n    evidence={\"connect_count\":50,\"parent_comm\":\"containerd-shim\",\"ppid\":9290}\r\n"]
